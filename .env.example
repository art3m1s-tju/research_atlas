# OpenAlex API Key (free account: https://openalex.org/settings/api)
OPENALEX_API_KEY=

# Semantic Scholar API Key (optional, for higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Crossref polite-pool email (optional, used for DOI metadata enrichment)
CROSSREF_MAILTO=

# Unpaywall email (optional, used to find legal open-access PDFs)
UNPAYWALL_EMAIL=

# Database path (default: ./data/atlas.db)
DATABASE_PATH=./data/atlas.db

# Local web port used by every launcher (npm run dev/start, one-click, Tailscale)
ATLAS_PORT=43117

# Cloud semantic-search embedding through DashScope's OpenAI-compatible API.
EMBEDDING_PROVIDER=api
EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
# Set EMBEDDING_PROVIDER=local only for an explicit offline development fallback.
TRANSFORMERS_CACHE=./.cache/transformers

# External paper API request controls
SYNC_REQUEST_TIMEOUT_MS=15000
SYNC_REQUEST_RETRIES=2
SYNC_MIN_INTERVAL_HOURS=12
CITATION_UPDATE_LIMIT=200
CITATION_UPDATE_CONCURRENCY=8

# Optional Chinese paper brief generation through DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CLASSIFIER_MODEL=deepseek-v4-flash
DEEPSEEK_CLASSIFIER_TIMEOUT_MS=30000
SUMMARY_CONCURRENCY=32
SUMMARY_LIMIT=0
DEEPSEEK_TRANSLATION_MODEL=deepseek-v4-flash
DEEPSEEK_SEMANTIC_MODEL=deepseek-v4-flash
# Optional PDFMathTranslate/BabelDOC backend. Keep "atlas" for Markdown output.
TRANSLATION_ENGINE=atlas
PDF2ZH_PYTHON_BIN=./.venv-pdf2zh/bin/python
PDF2ZH_HOME=./.cache/pdf2zh
PDF2ZH_VERSION=2.8.2
PDF2ZH_API_BASE_URL=
PDF2ZH_API_KEY=
PDF2ZH_MODEL=
PDF2ZH_LANG_IN=en
PDF2ZH_LANG_OUT=zh-CN
PDF2ZH_QPS=2
PDF2ZH_POOL_MAX_WORKERS=
PDF2ZH_ENABLE_JSON_MODE=1
PDF2ZH_NO_AUTO_EXTRACT_GLOSSARY=1
PDF2ZH_IGNORE_CACHE=0
PDF2ZH_NO_DUAL=0
PDF2ZH_NO_MONO=0
PDF2ZH_WATERMARK_OUTPUT_MODE=no_watermark
PDF2ZH_TRANSLATE_TABLE_TEXT=1
PDF2ZH_AUTO_ENABLE_OCR_WORKAROUND=1
PDF2ZH_ENHANCE_COMPATIBILITY=0
PDF2ZH_MAX_PAGES_PER_PART=
# Optional visual semantic review. Qwen3-VL-Flash is preferred; PaddleOCR-VL remains the fallback.
QWEN_VL_API_KEY=
QWEN_VL_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-flash
TRANSLATION_CONCURRENCY=2
TRANSLATION_CHUNK_CHARS=6000
# Set to 0 to skip the single low-token OCR/Markdown semantic review for ambiguous chart/table blocks.
TRANSLATION_SEMANTIC_REVIEW=1
# Cloud-first structured parser. The default avoids local Docling/pdftotext.
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_API_BASE_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_POLL_TIMEOUT_MS=1200000
# Set to 1 to disable local Docling, pdftotext, pdfimages, and pdftoppm paths.
TRANSLATION_CLOUD_ONLY=1
# paddleocr-only is the cloud parser; auto/docling are explicit local-development modes.
TRANSLATION_PARSER=paddleocr-only
# Optional parser/runtime fingerprint. Change it when the local parser or model is upgraded.
TRANSLATION_PARSER_VERSION=
TRANSLATION_ENABLE_OCR=0
TRANSLATION_ENABLE_FORMULA=1
TRANSLATION_IMAGE_SCALE=2

# Daily digest output and optional external delivery
DIGEST_BASE_URL=http://127.0.0.1:43117
DIGEST_OUTPUT_PATH=./data/daily-digest.md
DIGEST_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SYNC_CHECKPOINT_PATH=./data/sync-checkpoints.json
