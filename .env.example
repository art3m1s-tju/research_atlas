# OpenAlex API Key (free account: https://openalex.org/settings/api)
OPENALEX_API_KEY=

# Semantic Scholar API Key (optional, for higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Crossref polite-pool email (optional, used for DOI metadata enrichment)
CROSSREF_MAILTO=

# Unpaywall email (optional, used to find legal open-access PDFs)
UNPAYWALL_EMAIL=

# Database path (default: ./data/atlas.db)
DATABASE_PATH=./data/atlas.db

# Local web port used by every launcher (npm run dev/start, one-click, Tailscale)
ATLAS_PORT=43117

# Local semantic-search embedding model (downloaded on first sync)
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
TRANSFORMERS_CACHE=./.cache/transformers

# External paper API request controls
SYNC_REQUEST_TIMEOUT_MS=15000
SYNC_REQUEST_RETRIES=2
SYNC_MIN_INTERVAL_HOURS=12
CITATION_UPDATE_LIMIT=200
CITATION_UPDATE_CONCURRENCY=8

# Optional Chinese paper brief generation through DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CLASSIFIER_MODEL=deepseek-v4-flash
DEEPSEEK_CLASSIFIER_TIMEOUT_MS=30000
SUMMARY_CONCURRENCY=32
SUMMARY_LIMIT=0
DEEPSEEK_TRANSLATION_MODEL=deepseek-v4-flash
DEEPSEEK_SEMANTIC_MODEL=deepseek-v4-flash
# Optional visual semantic review. Qwen3-VL-Flash is preferred; PaddleOCR-VL remains the fallback.
QWEN_VL_API_KEY=
QWEN_VL_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-flash
TRANSLATION_CONCURRENCY=2
TRANSLATION_CHUNK_CHARS=6000
# Set to 0 to skip the single low-token OCR/Markdown semantic review for ambiguous chart/table blocks.
TRANSLATION_SEMANTIC_REVIEW=1
# Hosted structured parser used when local parsing is unavailable or fails.
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_API_BASE_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_POLL_TIMEOUT_MS=1200000
# auto: local Docling (or pdftotext) first, PaddleOCR fallback; docling/paddleocr-only force one path.
TRANSLATION_PARSER=auto

# Daily digest output and optional external delivery
DIGEST_BASE_URL=http://127.0.0.1:43117
DIGEST_OUTPUT_PATH=./data/daily-digest.md
DIGEST_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SYNC_CHECKPOINT_PATH=./data/sync-checkpoints.json
